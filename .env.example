# CreatorPilot Studio — optional configuration
# The studio runs with zero configuration in demo mode. Set these only for live mode.

PORT=3000
HOST=0.0.0.0

# Live text providers. Pick one, paste the key in Settings → AI providers,
# then switch the studio engine from "Demo" to "Live".
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=...
# DEEPSEEK_API_KEY=...
# ANTHROPIC_API_KEY=...

# Optional: force demo mode even if keys are present
# CREATORPILOT_DEMO=1

# ---- media studio (video + voice) -------------------------------------------
# Free-tier Google AI Studio key: https://aistudio.google.com/apikey
# One key powers both scene images (Gemini image) and narration (Gemini TTS).
# You can also paste it in Settings -> Voice & visuals; settings win over env.
# GEMINI_API_KEY=AIza...

# Optional alternative narration providers
# OPENAI_API_KEY=sk-...
# ELEVENLABS_API_KEY=xi-...

# Optional free image endpoint (no key needed): pollinations.ai
# Optional: point at a different ffmpeg binary
# FFMPEG_PATH=/usr/bin/ffmpeg
